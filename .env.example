# Public URL. On Vercel use APP_URL (Vercel may refuse NEXT_PUBLIC_ names).
# Defaults to the Vercel production URL when empty.
APP_URL=
DATABASE_URL=

ANTHROPIC_API_KEY=
# Optional override; defaults to claude-haiku-4-5
ANTHROPIC_MODEL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Bot name without @. Shows the "Start in Telegram" button. Inlined at build time,
# so redeploy after changing it. NEXT_PUBLIC_TELEGRAM_BOT_USERNAME also works.
TELEGRAM_BOT_USERNAME=

NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Auctra's app-level P-256 AUTHORIZATION key (base64 PKCS8). It signs Auctra's API
# requests to Privy (privy-authorization-signature header). It is NOT a wallet key
# and cannot sign a blockchain transaction by itself. Generate with
# `npm run spike -- keygen`. Server-side only; never expose it to the client.
PRIVY_AUTHORIZATION_PRIVATE_KEY=
# ID of the Privy key quorum that holds the public half of that key. Users add this
# quorum to their wallet as a session signer. It does NOT own the spending policy:
# policies are owned by the user, so Auctra cannot change its own limits.
PRIVY_SIGNER_ID=

# Live spike only (tests/integration/monad-usdc-transfer.integration.test.ts).
# AUCTRA_LIVE_SPIKE=1 moves testnet funds. See docs/FEASIBILITY-privy-monad.md §13.
AUCTRA_LIVE_SPIKE=
SPIKE_PRIVY_WALLET_ID=
SPIKE_WALLET_ADDRESS=
SPIKE_POLICY_ID=
SPIKE_RECIPIENT=
# Optional: SPIKE_ALLOWLIST (comma list, defaults to SPIKE_RECIPIENT), SPIKE_AMOUNT_USDC (0.01),
# SPIKE_MAX_USDC (policy cap, defaults to 100), SPIKE_UNAUTHORIZED_RECIPIENT, SPIKE_PHASE=revoked

# The scheduler sends `Authorization: Bearer $CRON_SECRET` (Vercel Cron and
# .github/workflows/scheduler.yml). Use the same value in Vercel and in GitHub secrets.
CRON_SECRET=

# On-time runs: Upstash QStash wakes the app at each automation's exact time
# (lib/scheduler/wakeup.ts). Added automatically by Vercel's Upstash QStash integration.
QSTASH_TOKEN=
QSTASH_URL=

# TESTNET ONLY
AUCTRA_NETWORK=testnet
MONAD_CHAIN_ID=10143
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

AUCTRA_SUPPORTED_ASSET=USDC
