NEXT_PUBLIC_APP_URL=
DATABASE_URL=

ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
ANTHROPIC_MODEL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Optional: shows a "Start in Telegram" button on the landing page
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Auctra's app-level P-256 authorization key (session signer). Not a user key.
# Generate with `npm run spike -- keygen`. Server-side only; never expose to the client.
PRIVY_AUTHORIZATION_PRIVATE_KEY=
# Key quorum ID of Auctra's authorization key (Privy dashboard). Used as the session signer and policy owner.
PRIVY_SIGNER_ID=

# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`
CRON_SECRET=

# TESTNET ONLY
AUCTRA_NETWORK=testnet
MONAD_CHAIN_ID=10143
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

AUCTRA_SUPPORTED_ASSET=USDC
