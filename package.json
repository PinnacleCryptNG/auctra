{
  "name": "auctra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "if [ -n \"$VERCEL\" ] && [ -n \"$DATABASE_URL\" ]; then drizzle-kit migrate; fi && next build",
    "start": "next start",
    "lint": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:testnet": "tsx scripts/check-testnet-only.ts",
    "spike": "tsx --env-file-if-exists=.env.local scripts/spike.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "demo:build": "node demo/build.mjs",
    "test:integration": "AUCTRA_INTEGRATION=1 vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@neondatabase/serverless": "^1.0.2",
    "@privy-io/node": "^0.35.0",
    "@privy-io/react-auth": "^3.47.0",
    "@stripe/stripe-js": "^1.54.2",
    "drizzle-orm": "^0.45.3",
    "luxon": "^3.7.2",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "viem": "^2.38.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
